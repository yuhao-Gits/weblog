# ============================================================
# Weblog 环境变量模板
# 用法：复制为 .env 后按需修改，docker compose 会自动读取
#   cp .env.example .env
# 安全须知：本文件仅为模板，真实 .env 已在 .gitignore 中排除，禁止提交。
# ============================================================

# ---------- MySQL ----------
# MySQL root 密码（生产务必修改，强随机）
MYSQL_ROOT_PASSWORD=root

# ---------- 后端认证 ----------
# JWT 密钥（生产务必替换为 ≥32 字节的强随机值，可用 `openssl rand -base64 48` 生成）
WEBLOG_JWT_SECRET=please-change-this-jwt-secret-in-production

# ---------- 对象存储 Minio ----------
# Minio 根账号/密码（同时作为后端 access-key/secret-key 使用，生产务必修改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 桶名（Nginx /files 反代目标固定为 <bucket>，一般无需修改）
MINIO_BUCKET=weblog
# 后端存储切换：minio（生产默认）| local（本地磁盘兜底）
WEBLOG_STORAGE_TYPE=minio

# ---------- 镜像仓库（腾讯云 TCR） ----------
# 镜像注册中心地址（腾讯云 TCR 个人版）
IMAGE_REGISTRY=ccr.ccs.tencentcloud.com
# TCR 命名空间（需先在 TCR 控制台创建，替换为你的命名空间）
IMAGE_NAMESPACE=weblog
# 镜像 tag：本地/首次构建默认 latest；CI 发布时传 build-N
IMAGE_TAG=latest

# ---------- Jenkins ----------
# Jenkins 对外端口（宿主 8080，与后端容器内网 8080 不冲突）
JENKINS_PORT=8080
# 宿主 docker.sock 的 docker 组 gid（构建 jenkins 镜像时对齐权限用，Ubuntu 常见 999/998）
DOCKER_GID=999

# ---------- 部署目标（CI 发布用，生产按需填写） ----------
# 目标服务器 SSH 地址 / 用户 / 部署目录（Jenkinsfile 通过 Jenkins 凭据注入，此处仅占位说明）
# DEPLOY_HOST=62.234.30.116
# DEPLOY_USER=ubuntu
# DEPLOY_DIR=/opt/weblog
